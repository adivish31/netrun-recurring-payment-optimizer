# NetRun — copy to .env and fill in. NEVER commit .env.
# TEST KEYS ONLY. A key starting with rzp_live_ must never appear in this repo.

# Postgres. Only the Razorpay webhook endpoint needs it; the dashboard API
# serves data/generated/*.json and runs without a database.
DATABASE_URL=postgres://netrun:netrun@localhost:5432/netrun
# Optional: force SSL on/off (otherwise inferred from the URL).
# DATABASE_SSL=true

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Needed only for the "run live agent" button and LLM-path evals.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=

# Simulator
SEED=42
MANDATE_COUNT=400
CYCLE_COUNT=6
